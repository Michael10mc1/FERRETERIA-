# Clave secreta de Hive V3. Solo para el backend; nunca usar VITE_ para esta clave.
HIVE_API_KEY=
HIVE_BASE_URL=https://api-cdn.thehive.ai/api/v3
HIVE_MODEL=deepseek-ai/deepseek-v4.1-flash

# Dirección PostgreSQL completa, privada, para la migración local a Neon.
NEON_DATABASE_URL=
# En Render: DATABASE_URL con la misma conexión y COOKIE_SECURE=1.
# Sin DATABASE_URL la aplicación local conserva su base SQLite.
